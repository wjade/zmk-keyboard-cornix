+static float trackpoint_pointer_gain(struct trackpoint_data *data, uint32_t now) {
+    const uint32_t elapsed = now - data->last_pointer_motion_time;
+    const uint32_t ramp_end = TRACKPOINT_RAMP_DELAY_MS + TRACKPOINT_RAMP_DURATION_MS;
+
+    if (!data->pointer_moving || elapsed >= TRACKPOINT_RAMP_IDLE_MS) {
+        data->pointer_motion_ms = 0;
+    } else {
+        data->pointer_motion_ms = MIN(data->pointer_motion_ms + elapsed, ramp_end);
+    }
+
+    data->pointer_moving = true;
+    data->last_pointer_motion_time = now;
+    if (data->pointer_motion_ms <= TRACKPOINT_RAMP_DELAY_MS) {
+        return 1.0f;
+    }
+
+    const float progress =
+        (float)(data->pointer_motion_ms - TRACKPOINT_RAMP_DELAY_MS) / TRACKPOINT_RAMP_DURATION_MS;
+    return 1.0f + progress * (TRACKPOINT_RAMP_MAX_GAIN - 1.0f);
+}
